# Staging WordPress site (behind HTTP Basic Auth)
STAGING_URL=
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# WordPress Application Password (wp-admin -> Users -> Edit -> Application Passwords)
WP_USERNAME=
WP_APPLICATION_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Translation quality matters most here -- keep on the full model.
DEFAULT_MODEL=deepseek-v4-pro
# Review/terminology-validation calls are a narrower checking task; the
# cheaper model cuts cost ~3x with no observed quality drop (2026-08-06).
QA_MODEL=deepseek-v4-flash
SOURCE_LANGUAGE=en
TARGET_LANGUAGES=es
